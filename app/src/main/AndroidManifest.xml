<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 兼容无触摸屏的投影仪（坚果 N1 Air 第四代）与各类 Android TV 电视盒子 -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.faketouch"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      针对 2GB RAM 坚果 N1 Air 第四代（Android 13）：
      1. 开启全局硬件加速 (hardwareAccelerated="true")
      2. 关闭 largeHeap，保持紧凑 JVM 堆水位，配合 MemoryGovernor 动态回收
      3. 允许明文 HTTP 以支持 127.0.0.1 流媒体解密网关与局域网手机扫码遥控
    -->
    <application
        android:name=".JuJuApplication"
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:hardwareAccelerated="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.JuJuTV"
        android:usesCleartextTraffic="true">

        <!-- 主界面：同时注册普通安卓桌面与 Android TV Leanback 桌面入口 -->
        <activity
            android:name=".ui.MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 剧集详情与选集网格页 -->
        <activity
            android:name=".ui.DetailActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- 全屏硬件 Overlay 直出播放页 -->
        <activity
            android:name=".ui.PlayerActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:supportsPictureInPicture="true" />

    </application>

</manifest>
